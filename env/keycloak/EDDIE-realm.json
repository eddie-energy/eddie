{
  "realm": "EDDIE",
  "enabled": true,
  "defaultRoles": [
    "manage-account"
  ],
  "loginTheme": "eddie-theme",
  "clientScopes": [
    {
      "name": "agnostic-connection-status-messages:read",
      "protocol": "openid-connect"
    },
    {
      "name": "agnostic-raw-data-messages:read",
      "protocol": "openid-connect"
    },
    {
      "name": "agnostic-permission-command:write",
      "protocol": "openid-connect"
    },
    {
      "name": "agnostic-opaque_envelope:write",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-permission-md:read",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-accounting-point-data-md:read",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-validated-historical-data-md:read",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-near-real-time-data-md:read",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-acknowledgement-md:read",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-termination-md:write",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-redistribution-transaction-rd:write",
      "protocol": "openid-connect"
    },
    {
      "name": "cim-min-max-envelope-md:write",
      "protocol": "openid-connect"
    }
  ],
  "clients": [
    {
      "id": "eddie-client",
      "clientId": "eddie-client",
      "secret": "client-secret",
      "enabled": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*", "http://eddie:*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "optionalClientScopes": [
        "offline_access",
        "agnostic-connection-status-messages:read",
        "agnostic-raw-data-messages:read",
        "agnostic-permission-command:write",
        "agnostic-opaque_envelope:write",
        "cim-permission-md:read",
        "cim-accounting-point-data-md:read",
        "cim-validated-historical-data-md:read",
        "cim-near-real-time-data-md:read",
        "cim-acknowlegement-md:read",
        "cim-termination-md:write",
        "cim-redistribution-transaction-rd:write",
        "cim-min-max-envelope-md:write"
      ]
    },
    {
      "id": "example-app-client",
      "clientId": "example-app-client",
      "enabled": true,
      "redirectUris": [
        "http://localhost:8082/*"
      ],
      "webOrigins": [
        "http://localhost:8082"
      ],
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true"
          }
        },
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": {
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "config": {
            "access.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "eddie",
      "email": "eddie@eddie.local",
      "firstName": "John",
      "lastName": "Doe",
      "enabled": true,
      "clientRoles": {
        "account": [
          "manage-account"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "eddie"
        }
      ]
    }
  ]
}
