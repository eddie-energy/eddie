@startuml
'https://plantuml.com/class-diagram

hide empty members
left to right direction

class Permission {
    - permissionId: UUID
    - eddieId: UUID
    - userId: UUID
    - status: PermissionStatus
    - serviceName: String
    - displayName: String
    - startTime: Instant
    - expirationTime: Instant
    - grantTime: Instant
    - revokeTime: Instant
    - connectionId: String
    - meterId: String
    - minLimitKw: BigDecimal
    - maxLimitKw: BigDecimal
    - monitoringDataSourceId: UUID
    - handshakeUrl: String
    - accessToken: String
    - dataNeed: AiidaLocalDataNeed
    - mqttStreamingConfig: MqttStreamingConfig
    - dataSource: DataSource
    - inboundMessageFormat: InboundMessageFormat
    - transmissionEnabled: boolean
    - transmissionSchedule: CronExpression
}

class AiidaLocalDataNeed {
}

abstract class DataSource {}

class MqttStreamingConfig {
    - permissionId: UUID
    - password: String
    - serverUri: String
    - dataTopic: String
    - statusTopic: String
    - commandTopic: String
    - acknowledgementTopic: String
}

enum PermissionStatus {
    ACCEPTED
    REVOKED
    TERMINATED
    FULFILLED
}

enum ConnectionStatus {
    WAITING_FOR_CONNECTION
    NOT_CONNECTED
    CONNECTED
}

note bottom of ConnectionStatus
    Not persisted, derived at runtime
    for accepted permissions.
end note

enum InboundMessageFormat {
    CIM_1_12
    OPENADR_3_1
}

Permission "n" o-- "1" AiidaLocalDataNeed
Permission - PermissionStatus
Permission ..> ConnectionStatus : derived
Permission - InboundMessageFormat
Permission "1" *-up- "1" MqttStreamingConfig
Permission "n" o-- "1" DataSource

@enduml